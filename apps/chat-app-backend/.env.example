# Copy to .env. Docker only uses the first block; without Docker, export all of it.

# Access tokens come from the auth service; the issuer is its AUTH_PUBLIC_URL
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=chatwave

CORS_ORIGIN=http://localhost:3003,http://localhost:80
# Allow any private-network origin (phones on the same Wi-Fi)
ALLOW_LAN_ORIGINS=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=chat-uploads

TURN_USER=chat
TURN_PASSWORD=chatpass
TURN_HOST=localhost
TURN_EXTERNAL_IP=127.0.0.1

# Without Docker only
# AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# PORT=3002
# MONGODB_URI=mongodb://127.0.0.1:27018/realtime_chat
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_REGION=us-east-1
# MAX_FILE_SIZE_MB=25
# TURN_PORT=3478
# Origin the mobile app sends; trusted by better-auth
# MOBILE_APP_ORIGIN=chatwave://
