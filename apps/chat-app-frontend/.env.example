# Copy to .env. Only VITE_* reach the browser.

# Where Vite proxies /api + /socket.io (chat backend) and /auth-api (auth service)
API_PROXY_TARGET=http://127.0.0.1:3002
AUTH_PROXY_TARGET=http://127.0.0.1:3001

# Optional overrides; default to the proxied paths
# VITE_API_URL=/api
# VITE_AUTH_URL=/auth-api
# VITE_SOCKET_URL=
