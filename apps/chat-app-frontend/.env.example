# Copy to .env. Only VITE_* reach the browser.

# Where Vite proxies /api + /socket.io (chat backend) and /auth-api (auth service)
API_PROXY_TARGET=http://127.0.0.1:3004
AUTH_PROXY_TARGET=http://127.0.0.1:3005
# Serve https://<host>:5176 with a self-signed cert so phones on the LAN can use camera/mic
DEV_HTTPS=false

# Optional overrides; default to the proxied paths
# VITE_API_URL=/api
# VITE_AUTH_URL=/auth-api
# VITE_SOCKET_URL=
