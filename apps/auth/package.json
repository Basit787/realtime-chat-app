{
  "name": "@chat/auth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src libs test --max-warnings 0",
    "lint:fix": "eslint src libs test --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:seed": "nest build && node dist/src/main.js seed",
    "db:reset": "nest build && node dist/src/main.js reset"
  },
  "dependencies": {
    "backend-common": "workspace:*",
    "ports": "workspace:*",
    "@nestjs/common": "*",
    "@nestjs/config": "*",
    "@nestjs/core": "*",
    "@nestjs/mongoose": "*",
    "@nestjs/platform-express": "*",
    "@nestjs/swagger": "*",
    "better-auth": "*",
    "class-transformer": "*",
    "class-validator": "*",
    "helmet": "*",
    "jose": "*",
    "mongoose": "*",
    "reflect-metadata": "*",
    "rxjs": "*"
  },
  "devDependencies": {
    "eslint-config": "workspace:*",
    "prettier-config": "workspace:*",
    "@nestjs/cli": "*",
    "@nestjs/schematics": "*",
    "@nestjs/testing": "*",
    "@types/multer": "*",
    "@types/node": "*",
    "@types/supertest": "*",
    "@vitest/coverage-v8": "*",
    "supertest": "*",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  },
  "prettier": "prettier-config"
}
