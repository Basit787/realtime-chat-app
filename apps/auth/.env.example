# Copy to .env. Docker only uses the first block; without Docker, export all of it.

BETTER_AUTH_SECRET=dev-secret-change-me
# Public URL of this service (JWT issuer, avatar links); must be reachable from browsers and phones
AUTH_PUBLIC_URL=http://localhost:3001
AUTH_AUDIENCE=chatwave
ACCESS_TOKEN_TTL=15m
# Refresh-token cookie: lifetime (renewed on every use) and the Secure flag (turn on behind HTTPS)
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

CORS_ORIGIN=http://localhost:3003,http://localhost:80
# Allow any private-network origin (phones on the same Wi-Fi)
ALLOW_LAN_ORIGINS=true

ADMIN_EMAIL=admin@chat.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=admin

# Without Docker only
# PORT=3001
# MONGODB_URI=mongodb://127.0.0.1:27018/realtime_chat
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=chat-uploads
# MINIO_REGION=us-east-1
# Origin the mobile app sends; trusted by better-auth
# MOBILE_APP_ORIGIN=chatwave://
