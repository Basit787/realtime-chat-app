# Copy to .env. Docker only uses the first block; without Docker, export all of it.

# Access tokens come from the auth service; the issuer is its AUTH_PUBLIC_URL
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=chatwave

CORS_ORIGIN=http://localhost:3005

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=image-uploads

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Without Docker only
# AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# PORT=3006
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/image_upload
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_REGION=us-east-1
# MAX_FILE_SIZE_MB=10
# REDIS_URL=redis://127.0.0.1:6379
# BIN_RETENTION_DAYS=30
# Cron pattern for the bin purge (hourly)
# BIN_PURGE_CRON=0 * * * *
