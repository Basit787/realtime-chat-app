{
  "name": "@chat/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:up": "docker compose up mongo -d",
    "db:down": "docker compose stop mongo",
    "db:ui": "docker compose up mongo-express -d",
    "docker:up": "docker compose up -d",
    "docker:up:build": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up --build -d"
  },
  "dependencies": {
    "@chat/backend-common": "workspace:*",
    "better-auth": "catalog:",
    "cors": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "helmet": "catalog:",
    "mongoose": "catalog:",
    "socket.io": "catalog:",
    "swagger-ui-express": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chat/eslint-config": "workspace:*",
    "@chat/prettier-config": "workspace:*",
    "@chat/tsconfig": "workspace:*",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/swagger-ui-express": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@chat/prettier-config"
}
