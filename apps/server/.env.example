# Variables for apps/server/docker-compose.*.yml (copy to .env next to this file).
# Without Docker, export the same names (plus MONGODB_URI / MINIO_ENDPOINT) before `pnpm dev`.

# Auth
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:5176

# Allowed browser origins (comma-separated)
CORS_ORIGIN=http://localhost:5176,http://localhost:80
# Also allow any private-network origin (e.g. http://192.168.1.20:5176 from a phone on the same Wi-Fi).
# Defaults to true in docker-compose.dev.yml, false in docker-compose.prod.yml.
ALLOW_LAN_ORIGINS=true

# WebRTC / TURN (coturn)
TURN_USER=chat
TURN_PASSWORD=chatpass
TURN_HOST=localhost
TURN_EXTERNAL_IP=127.0.0.1

# Default admin (created on server startup)
ADMIN_EMAIL=admin@chat.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=admin

# MinIO object storage (required — all files are stored here)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=chat-uploads
