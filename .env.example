# Copy to .env for Docker (`make`); docker-compose.yml reads it. Every value has a default.

# Server
PUBLIC_URL=http://localhost:3001
BETTER_AUTH_SECRET=dev-secret-change-me
AUTH_AUDIENCE=chatwave
ACCESS_TOKEN_TTL=15m
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000,http://localhost:80
ALLOW_LAN_ORIGINS=true

# Admin account created by `pnpm db:seed` (docker compose exec server pnpm db:seed)
ADMIN_EMAIL=admin@chat.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=admin

# MinIO (object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=chat-uploads

# coturn (WebRTC TURN); on a remote server set TURN_HOST and TURN_EXTERNAL_IP to its public address
TURN_USER=chat
TURN_PASSWORD=chatpass
TURN_HOST=localhost
TURN_EXTERNAL_IP=127.0.0.1

# Client: base URL of the terms, privacy and cookie pages
# VITE_LEGAL_URL=https://example.com
