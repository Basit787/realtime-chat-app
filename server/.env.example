# For running the server outside Docker (see "Local development" in the README): copy to .env and export it,
# e.g. `set -a; . ./.env; set +a`. Prisma's CLI (db push, db seed) also reads this file by itself.
# Docker reads the root .env instead (see ../.env.example).

PORT=3001
# directConnection: the replica set advertises the container's own address, unreachable from this machine
MONGODB_URI=mongodb://127.0.0.1:27018/realtime_chat?directConnection=true
PUBLIC_URL=http://localhost:3001

BETTER_AUTH_SECRET=dev-secret-change-me
AUTH_AUDIENCE=chatwave
ACCESS_TOKEN_TTL=15m
# Refresh-token cookie: lifetime (renewed on every use) and the Secure flag (turn on behind HTTPS)
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

CORS_ORIGIN=http://localhost:3000,http://localhost:80
# Allow any private-network origin (phones on the same Wi-Fi)
ALLOW_LAN_ORIGINS=true

# Admin account created by `pnpm db:seed`
ADMIN_EMAIL=admin@chat.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=admin

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chat-uploads
MINIO_REGION=us-east-1
MAX_FILE_SIZE_MB=25

TURN_HOST=localhost
TURN_PORT=3478
TURN_USER=chat
TURN_PASSWORD=chatpass
