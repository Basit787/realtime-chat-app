# Copy to .env. Only VITE_* reach the browser.

# Where Vite proxies /api and /socket.io (the chat server)
API_PROXY_TARGET=http://127.0.0.1:3001

# Optional overrides; default to the proxied paths
# VITE_API_URL=/api
# VITE_SOCKET_URL=
# Base URL of the terms, privacy and cookie pages
# VITE_LEGAL_URL=https://example.com
