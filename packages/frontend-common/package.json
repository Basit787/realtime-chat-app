{
  "name": "frontend-common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "prettier": "prettier-config",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pui": "workspace:*",
    "axios": "*",
    "date-fns": "*"
  },
  "peerDependencies": {
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "eslint-config": "workspace:*",
    "prettier-config": "workspace:*",
    "tsconfig": "workspace:*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "tsup": "*",
    "typescript": "*"
  }
}
