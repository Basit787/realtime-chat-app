{
  "name": "@chat/frontend-common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "prettier": "@chat/prettier-config",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "date-fns": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@chat/eslint-config": "workspace:*",
    "@chat/prettier-config": "workspace:*",
    "@chat/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
