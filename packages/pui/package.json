{
  "name": "pui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./globals.css": "./dist/globals.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "*",
    "@shadcn/react": "*",
    "class-variance-authority": "*",
    "clsx": "*",
    "cmdk": "*",
    "date-fns": "*",
    "embla-carousel-react": "*",
    "input-otp": "*",
    "radix-ui": "*",
    "react-day-picker": "*",
    "react-resizable-panels": "*",
    "recharts": "*",
    "shadcn": "*",
    "tailwind-merge": "*",
    "tw-animate-css": "*",
    "vaul": "*"
  },
  "peerDependencies": {
    "@hookform/resolvers": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "react-hook-form": "*",
    "sonner": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@hookform/resolvers": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "eslint-config": "workspace:*",
    "lucide-react": "*",
    "prettier-config": "workspace:*",
    "react": "*",
    "react-dom": "*",
    "react-hook-form": "*",
    "sonner": "*",
    "tailwindcss": "*",
    "tsconfig": "workspace:*",
    "tsup": "*",
    "typescript": "*",
    "zod": "*"
  },
  "prettier": "prettier-config"
}
