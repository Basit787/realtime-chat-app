{
  "name": "@chat/backend-common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prettier": "@chat/prettier-config",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "multer": "catalog:"
  },
  "peerDependencies": {
    "express": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chat/eslint-config": "workspace:*",
    "@chat/prettier-config": "workspace:*",
    "@chat/tsconfig": "workspace:*",
    "@types/express": "catalog:",
    "@types/multer": "catalog:",
    "express": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
